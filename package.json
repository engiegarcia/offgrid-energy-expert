{
  "name": "offgrid-energy-expert-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend del sistema experto de selección de energías renovables off-grid (UNMSM · Sistemas Inteligentes)",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
